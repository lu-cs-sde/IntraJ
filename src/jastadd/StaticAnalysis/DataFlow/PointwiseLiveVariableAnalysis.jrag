aspect PointwiseLiveVariableAnalysis {
// public
//   interface UnaryIncDec {}
//   PostfixExpr implements UnaryIncDec;
//   PreIncExpr implements UnaryIncDec;
//   PreDecExpr implements UnaryIncDec;

// public
//   interface CompoundAssignment {}
//   AssignBitwiseExpr implements CompoundAssignment;
//   AssignShiftExpr implements CompoundAssignment;
//   AssignMultiplicativeExpr implements CompoundAssignment;
//   AssignAdditiveExpr implements CompoundAssignment;

  /**
   * For compound assignment the l-value is read therefore is considered a use.
   */
  eq CompoundAssignment.PwLVA_use(Variable v) = isVarDecl(v);

  /* --- Def sets --- */
  syn boolean CFGNode.PwLVA_def(Variable v)  = false;
  eq VariableDeclarator.PwLVA_def(Variable v) = v == singletonValue();
  eq AssignExpr.PwLVA_def(Variable v) = isVarDecl(v);
  eq UnaryIncDec.PwLVA_def(Variable v) = isVarDecl(v);
  eq ImplicitAssignment.PwLVA_def(Variable v) = false;

  /* --- Use sets --- */
  syn boolean CFGNode.PwLVA_use(Variable v) = false;
  eq VarAccess.PwLVA_use(Variable v) = isVarDecl(v);
  eq UnaryIncDec.PwLVA_use(Variable v) = isVarDecl(v);

  /* --- Out sets --- */
  syn boolean CFGNode.PwLVA_out(Variable v) {
    for (CFGNode e : succ()) {
      if (e.PwLVA_in(v)) {
        return true;
      }
    }
    return false;
  }

  /* --- In sets --- */
  syn boolean CFGNode.PwLVA_in(Variable v) circular[false] = PwLVA_out(v);
  eq VariableDeclarator.PwLVA_in(Variable v) = PwLVA_use(v) || (!PwLVA_def(v) && PwLVA_out(v));
  eq AssignExpr.PwLVA_in(Variable v) =         PwLVA_use(v) || (!PwLVA_def(v) && PwLVA_out(v));
  eq UnaryIncDec.PwLVA_in(Variable v) =        PwLVA_use(v) || (!PwLVA_def(v) && PwLVA_out(v));
  eq VarAccess.PwLVA_in(Variable v) =          PwLVA_use(v) || (!PwLVA_def(v) && PwLVA_out(v));



  /* --- getVarDeclSet --- */

  syn boolean CFGNode.isVarDecl(Variable v) = false;
  eq VariableDeclarator.isVarDecl(Variable v) = v == singletonValue();
  eq VarAccess.isVarDecl(Variable v) = (!isDest()) ? v == decl() : false;
  eq UnaryIncDec.isVarDecl(Variable v) = getOperand() != null && getOperand().varDecl() == v;
  eq AssignExpr.isVarDecl(Variable v)  = getDest() != null && getDest().varDecl() == v;
}
