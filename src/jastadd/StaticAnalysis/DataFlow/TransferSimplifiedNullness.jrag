import org.extendj.flow.utils.Gamma;
import org.extendj.ast.SmallSet;
aspect TsNPA {
  // Add analysis to the StaticAnalysis registry:
  public static StaticAnalysis StaticAnalysis.TsNPA =
    StaticAnalysis.dataFlow("Null Pointer Dereference (transfer-simplified)",
                            (CompilationUnit cu) -> cu.TsNPA())
      .implementsAnalysis("NPA");

  /* --- TRFunction --- */
  syn Gamma CFGNode.TsNA_out() circular [Gamma.EMPTY] { return TsNA_in(); }
  eq Assign.TsNA_out() {
    Gamma gamma = new Gamma(TsNA_in());
    Variable decl = getDeclaration();
    if (TsNA_getMayBeNull()) {
      gamma._put(decl, AbsDomain.NULL);
    } else {
      gamma._put(decl, AbsDomain.NOTNULL);
    } return gamma;
  }

  eq VarAccess.TsNA_out() {
    Gamma gamma = TsNA_in();
    Variable decl = varDecl();
    if (TsNA_in().get(decl) == AbsDomain.NULL && isDereferencing()) {
      gamma = new Gamma(gamma);
      gamma._put(decl, AbsDomain.NOTNULL);
    }
    return gamma;
  }

  /* --- Out Environment --- */

  /* -- This doesn't seem to ever get used-- disabled -- */

  // coll Gamma TryStmt.TsNA_out() with join; // TryStmt is not a CFGNode

  // CFGNode contributes  TsNA_out()
  //  when getEnclosingTry()!=null to TryStmt.TsNA_out()  for getEnclosingTry();

  /* --- In Environment --- */
  syn Gamma CFGNode.TsNA_in() circular[Gamma.EMPTY] {
    Iterator<CFGNode> iter = pred().iterator();
    if (!iter.hasNext()) {
        return Gamma.EMPTY;
    }

    Gamma res = iter.next().TsNA_out();
    if (!iter.hasNext()) {
        return res;
    }

    // must join
    res = new Gamma(res);

    while (iter.hasNext()) {
      res.join(iter.next().TsNA_out());
    }
    return res;
  }
  eq Entry.TsNA_in() = Gamma.EMPTY;

  /* --- Error Predicate / isNullable --- */
  syn boolean VarAccess.TsNA_isNullable() {
    AbsDomain res = TsNA_in().get(varDecl());
    return isDereferencing() && (res == AbsDomain.NULL);
  }

  /* --- Error Collection --- */
  VarAccess contributes warning(
      getCompilationUnit().pathName(),
      "A 'NullPointerException' could be thrown;'" + name() + "' is nullable.",
      StaticAnalysis.TsNPA,
      null, null) when
  TsNA_isNullable() to CompilationUnit.TsNPA();

  /* --- Helpers --- */

  syn boolean Expr.TsNA_getMayBeNull() = false;
  syn boolean Assign.TsNA_getMayBeNull() = getMayBeNull();
  eq NullLiteral.TsNA_getMayBeNull() = true;
  eq VarAccess.TsNA_getMayBeNull() = TsNA_in().get(varDecl()) == AbsDomain.NULL;
  eq AssignExpr.TsNA_getMayBeNull() = getSource().TsNA_getMayBeNull();
  eq ConditionalExpr.TsNA_getMayBeNull() =
      getTrueExpr().TsNA_getMayBeNull() || getFalseExpr().TsNA_getMayBeNull();
  syn boolean VariableDeclarator.TsNA_getMayBeNull() =
      hasInit() ? getInit().TsNA_getMayBeNull() : false;

}
