import org.extendj.flow.utils.Gamma;
import org.extendj.ast.SmallSet;
aspect PointwiseNPA {
  // Add analysis to the StaticAnalysis registry:
  public static StaticAnalysis StaticAnalysis.PwNPA =
    StaticAnalysis.dataFlow("Null Pointer Dereference (pointwise)",
                            (CompilationUnit cu) -> cu.PwNPA())
      .implementsAnalysis("NPA");

  // MAY-NULL analysis
  // Encode NULL    = true
  //        NOTNULL = false
  syn boolean CFGNode.PwNA_out(Variable v) circular [false] { return PwNA_in(v); }
  eq Assign.PwNA_out(Variable v) {
    if (v == getDeclaration()) {
      return PwNA_getMayBeNull();
    } else {
      return PwNA_in(v);
    }
  }

  eq VarAccess.PwNA_out(Variable v) {
    if (v == varDecl()) {
      return !isDereferencing() && PwNA_in(v);
    } else {
      return PwNA_in(v);
    }
  }

  /* --- Out Environment --- */

  /* -- This doesn't seem to ever get used-- disabled -- */

  // coll Boolean TryStmt.PwNA_out(Variable v) with logicalOr; // TryStmt is not a CFGNode

  // CFGNode contributes  PwNA_out(Variable v)
  //  when getEnclosingTry() !=null to TryStmt.PwNA_out(v)  for getEnclosingTry();

  /* --- In Environment --- */
  syn boolean CFGNode.PwNA_in(Variable v) circular[false] {
    for (CFGNode p: pred()) {
        if (p.PwNA_out(v)) {
            return true;
        }
    }
    return false;
  }
  eq Entry.PwNA_in(Variable v) = false;

  /* --- Error Predicate / isNullable --- */
  syn boolean VarAccess.PwNA_isNullable() {
    return isDereferencing() && PwNA_in(varDecl());
  }

  /* --- Error Collection --- */
  VarAccess contributes warning(
      getCompilationUnit().pathName(),
      "A 'NullPointerException' could be thrown;'" + name() + "' is nullable.",
      StaticAnalysis.PwNPA,
      null, null) when
  PwNA_isNullable() to CompilationUnit.PwNPA();

  /* --- Helpers --- */

  syn boolean Expr.PwNA_getMayBeNull() = false;
  syn boolean Assign.PwNA_getMayBeNull() = getMayBeNull();
  eq NullLiteral.PwNA_getMayBeNull() = true;
  eq VarAccess.PwNA_getMayBeNull() = PwNA_in(varDecl());
  eq AssignExpr.PwNA_getMayBeNull() = getSource().PwNA_getMayBeNull();
  eq ConditionalExpr.PwNA_getMayBeNull() =
      getTrueExpr().PwNA_getMayBeNull() || getFalseExpr().PwNA_getMayBeNull();
  syn boolean VariableDeclarator.PwNA_getMayBeNull() =
      hasInit() ? getInit().PwNA_getMayBeNull() : false;

}
