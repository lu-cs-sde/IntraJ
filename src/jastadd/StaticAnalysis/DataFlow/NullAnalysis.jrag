import org.extendj.flow.utils.Gamma;
import org.extendj.ast.SmallSet;
aspect NPA {
  // Add analysis to the StaticAnalysis registry:
  public static StaticAnalysis StaticAnalysis.NPA =
    StaticAnalysis.dataFlow("Null Pointer Dereference (product lattice)",
                            (CompilationUnit cu) -> cu.NPA())
      .implementsAnalysis("NPA");

  /* --- TRFunction --- */
  syn Gamma CFGNode.NA_trFun(Gamma gamma) { return gamma; }
  eq Assign.NA_trFun(Gamma gamma) {
    Variable decl = getDeclaration();
    if (NA_getMayBeNull())
      gamma._put(decl, AbsDomain.NULL);
    else
      gamma._put(decl, AbsDomain.NOTNULL);
    return gamma;
  }

  eq VarAccess.NA_trFun(Gamma gamma) {
    Variable decl = varDecl();
    if (NA_in().get(decl) == AbsDomain.NULL && isDereferencing())
      gamma._put(decl, AbsDomain.NOTNULL);
    return gamma;
  }

  /* --- Out Environment --- */

  /* -- This doesn't seem to ever get used-- disabled -- */

  // coll Gamma TryStmt.NA_out() with join; // TryStmt is not a CFGNode

  // CFGNode contributes  NA_trFun(NA_out())
  //  when getEnclosingTry()!=null to TryStmt.NA_out()  for getEnclosingTry();

  syn Gamma CFGNode.NA_out() circular[new Gamma()] {
    Gamma res = new Gamma(NA_in());
    res = NA_trFun(res);
    return res;
  }

  /* --- In Environment --- */
  syn Gamma CFGNode.NA_in() circular[new Gamma()] {
    Gamma res = new Gamma();
    for (CFGNode e : pred())
      res.join(e.NA_out());
    return res;
  }
  eq Entry.NA_in() = new Gamma();

  /* --- Error Predicate / isNullable --- */
  syn Boolean VarAccess.NA_isNullable() {
    AbsDomain res = NA_in().get(varDecl());
    return isDereferencing() && (res == AbsDomain.NULL);
  }

  /* --- Error Collection --- */
  VarAccess contributes warning(
      getCompilationUnit().pathName(),
      "A 'NullPointerException' could be thrown;'" + name() + "' is nullable.",
      StaticAnalysis.NPA,
      null, null) when
  NA_isNullable() to CompilationUnit.NPA();

  /* --- Helpers --- */

  syn boolean Expr.NA_getMayBeNull() = false;
  syn boolean Assign.NA_getMayBeNull() = getMayBeNull();
  eq NullLiteral.NA_getMayBeNull() = true;
  eq VarAccess.NA_getMayBeNull() = NA_in().get(varDecl()) == AbsDomain.NULL;
  eq AssignExpr.NA_getMayBeNull() = getSource().NA_getMayBeNull();
  eq ConditionalExpr.NA_getMayBeNull() =
      getTrueExpr().NA_getMayBeNull() || getFalseExpr().NA_getMayBeNull();
  syn boolean VariableDeclarator.NA_getMayBeNull() =
      hasInit() ? getInit().NA_getMayBeNull() : false;

}
