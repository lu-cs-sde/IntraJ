import java.util.ArrayList;
import java.util.Set;
import java.util.Map;
import java.util.HashMap;
import java.util.Collections;


import java.io.PrintStream;
import org.extendj.flow.utils.Utils;
import org.extendj.flow.utils.IJPosition;
import org.extendj.ast.StaticAnalysis;

aspect StaticAnalysis {

    /**
     * Functional interface for running static analyses
     *
     * [CR] This is WORKAROUND for an unsound limitation in CAT
     * (<tt>cat.jar</tt>), the static call graph analysis tool, which
     * we hereby trick into conservatively assuming that
     * {@link StaticAnalysisRunner::run} can execute any of the registered
     * static analyses.  (The code is now refactored to fold this into
     * StaticAnalysis, but I am preserving the interface for clarity.)
     *
     * As of 2026-08-29, CAT does not handle <tt>LambdaExpr</tt>
     * correctly, but it does seem to handle anonymous classes
     * sufficiently conservatively.
     */
    interface StaticAnalysisRunner {
        /**
         * Apply the static analysis to the given compilation unit and obtain all warnings for that unit
         */
        public Collection<? extends Warning> run(CompilationUnit cu);
    }

    /**
     * Registry for static analyses that are run once per compilation unit
     *
     * To register a new analysis, declare a static field and initialise it with
     * the result of {@link #dataFlow(String, String, StaticAnalysisRunner)},
     * {@link #localPattern(String, String, StaticAnalysisRunner)} etc.
     * The name of the static field is then the short name of the analysis.
     */
    public abstract class StaticAnalysis implements Comparable<StaticAnalysis>, StaticAnalysisRunner {
        protected String description;
        protected String category;
        private String name = "<name not set>";

        // Variant implementations: see #implementsAnalysis(String).
        private String implementedAnalysis = null;

        public static enum Kind {
            DATA_FLOW("data flow"),
            LOCAL_PATTERN("");
            String sortLabel;
            Kind(String name) {
                this.sortLabel = sortLabel;
            }
        }

        static final String DATA_FLOW = "data flow";
        static final String LOCAL_PATTERN = "";

        protected StaticAnalysis(Kind kind, String description) {
            this.description = description;
            this.category = kind.sortLabel;
        }

        /**
         * Declare this analysis to implement an analysis concept.
         *
         * Useful if multiple analyses are variants of each other and produce the same results
         * through different means.
         *
         * @param conceptualAnalysis Short name of the conceptual analysis.  Can be the same as the
         *   analysis name if we consider that analysis to be the default implementation.
         * @return <tt>this</tt>, for use in a field initialiser
         */
        public StaticAnalysis implementsAnalysis(String conceptualAnalysis) {
            if (this.implementedAnalysis != null) {
                throw new RuntimeException(this + " implements multiple analyses: [" + this.implementedAnalysis
                                           + ", " + conceptualAnalysis + "].  Not currently supported, please add support if really needed");
            }
            this.implementedAnalysis = conceptualAnalysis.replace('_', '-').intern();
            return this;
        }

        /**
         * Are the two analyses implementations of the same analysis?
         *
         * True for an analysis and itself, and for any two variants implementing the same conceptual analsis
         */
        public boolean sameAnalysisAs(StaticAnalysis other) {
            return other == this
                || (other != null && this.implementedAnalysis != null && this.implementedAnalysis == other.implementedAnalysis);
        }

        public String description() {
            return description;
        }

        public String name() {
            return name;
        }

        /**
         * The canonical (possibly abstract) name of the analysis
         *
         * This can be the same as {@link name()}.  For analysis variants, this is the name of the
         * base analysis,
         */
        public String canonicalName() {
            if (this.implementedAnalysis != null) {
                return this.implementedAnalysis;
            }
            return name();
        }

        /**
         * All implemented abstract analyses
         *
         * May be empty
         */
        public Collection<? extends String> implementedAnalyses() {
            if (this.implementedAnalysis == null) {
                return Collections.emptyList();
            }
            return Collections.singletonList(this.implementedAnalysis);
        }

        public String category() {
            return category;
        }

        private void setName(String newName) {
            this.name = newName;
        }

        public Collection<? extends Warning> scan(CompilationUnit unit) {
            return run(unit);
        }

        public boolean isCanonical() {
            return this.name().equals(this.canonicalName());
        }

        private static Map<String, StaticAnalysis> computeAnalyses() {
            Map<String, StaticAnalysis> unsortedResults = new LinkedHashMap<String, StaticAnalysis>();
            Map<String, ArrayList<String>> categoriesMap = new HashMap<String, ArrayList<String>>();
            try {
                for (java.lang.reflect.Field field: StaticAnalysis.class.getFields()) {
                    if (StaticAnalysis.class.isAssignableFrom(field.getType())
                        && (field.getModifiers() & java.lang.reflect.Modifier.STATIC) > 0) {
                        final String name = field.getName().replace('_', '-');
                        final StaticAnalysis analysis =
                            (StaticAnalysis) field.get(null);
                        if (!categoriesMap.containsKey(analysis.category())) {
                            categoriesMap.put(analysis.category(), new ArrayList<String>());
                        }
                        analysis.setName(name);
                        categoriesMap.get(analysis.category()).add(name);
                        unsortedResults.put(name,
                                            analysis);
                    }
                }
            } catch (IllegalAccessException exn) {
                exn.printStackTrace();
            }

            // Now sort first by category and then by short name of the analysis
            final ArrayList<String> categories = new ArrayList<String>(categoriesMap.keySet());
            final Map<String, StaticAnalysis> results = new LinkedHashMap<String, StaticAnalysis>();

            Collections.sort(categories);
            for (String category: categories) {
                final ArrayList<String> analysisNames = categoriesMap.get(category);
                Collections.sort(analysisNames);
                for (String name: analysisNames) {
                    results.put(name, unsortedResults.get(name));
                }
            }

            return results;
        }

        private static Map<String, StaticAnalysis> ANALYSIS_MAP = null;

        /**
         * Map from analysis names to the corresponding analyses
         *
         * Ordered, read-only
         */
        public static Map<? extends String, ? extends StaticAnalysis> analysisMap() {
            if (ANALYSIS_MAP == null) {
                ANALYSIS_MAP = computeAnalyses();
            }
            return ANALYSIS_MAP;
        }

        /**
         * Set of all analyses
         *
         * Ordered, read-only
         */
        public static Collection<? extends StaticAnalysis> analyses() {
            return analysisMap().values();
        }

        /**
         * Look up analysis by (string) name
         *
         * @param name Analysis name to look up
         * @return The corresponding analysis, or <tt>null</tt> if none
         */
        public static StaticAnalysis fromString(String name) {
            return analysisMap().get(name);
        }

        /**
         * All implementations of the given analysis
         *
         * All analyses that either match exactly by name or declare <tt>conceptualAnalysis</tt> as
         * its {@link implementedAnalysis}.
         *
         * Ordered, read-only
         */
        public static Collection<? extends StaticAnalysis> implementationsOf(String conceptualAnalysis) {
            Map<? extends String, ? extends StaticAnalysis> amap = analysisMap();
            final ArrayList<StaticAnalysis> results = new ArrayList<StaticAnalysis>();
            if (amap.containsKey(conceptualAnalysis)) {
                results.add(amap.get(conceptualAnalysis));
            }

            for (StaticAnalysis other: amap.values()) {
                if (!other.name.equals(conceptualAnalysis) // already included
                    && conceptualAnalysis.equals(other.implementedAnalysis)) {
                    results.add(other);
                }
            }
            return Collections.unmodifiableList(results);
        }

        public static int analysisNameMaxLength() {
            int max = 0;
            for (StaticAnalysis a: analyses()) {
                max = Integer.max(max, a.name().length());
            }
            return max;
        }

        /**
         * Print information on all static analyses
         */
        public static void printAnalyses(java.io.PrintStream out) {
            int maxNameLen = analysisNameMaxLength();
            String lastCategory = "";
            ArrayList<String> abstractAnalyses = new ArrayList<>();
            for (StaticAnalysis analysis: analyses()) {
                if (!analysis.category().equals(lastCategory)) {
                    lastCategory = analysis.category();
                    out.println("  -- " + analysis.category() + " --");
                }
                if (!analysis.implementedAnalyses().isEmpty()) {
                    for (String abstractAnalysis: analysis.implementedAnalyses()) {
                        if (!abstractAnalyses.contains(abstractAnalysis)) {
                            abstractAnalyses.add(abstractAnalysis);
                            out.println(String.format("    %s provided by:", abstractAnalysis));
                            for (StaticAnalysis impl: implementationsOf(abstractAnalysis)) {
                                out.println(String.format("      %-" + maxNameLen + "s  %s",
                                                          impl.name(), impl.description()));
                            }
                        }
                    }
                } else {
                    out.println(String.format("    %-" + maxNameLen + "s    %s%s",
                                              analysis.name(), analysis.description(),
                                              analysis.implementedAnalysis == null
                                              ? ""
                                              : " [implements " + analysis.implementedAnalysis + "]"));
                }
            }
        }

        @Override
        public String toString() {
            return this.name;
        }

        @Override
        public int compareTo(StaticAnalysis other) {
            return this.name.compareTo(other.name);
        }
    }

    /**
     * Warning: potential issue flagged by a static analysis
     */
    public class Warning implements Comparable<Warning> {
        private final Integer lineStart, columnStart, lineEnd, columnEnd;
        private final String errMsg;
        final StaticAnalysis analysis;
        final String sourceFilePath;
        private final Pair<Position, String> repair;
        private final java.util.List<Pair<Position, String>> relatedInfo;
        private IJPosition position = null;
        private String code = "Error...";

        public Warning(String sourceFilePath, StaticAnalysis analysis,
                       Integer lineStart, Integer columnStart, Integer lineEnd,
                       Integer columnEnd, String errMsg,
                       Pair<Position, String> repair,
                       java.util.List<Pair<Position, String>> relatedInfo) {
            this.analysis = analysis;
            this.lineStart = lineStart;
            this.lineEnd = lineEnd;
            this.errMsg = errMsg;
            this.sourceFilePath = sourceFilePath;
            this.columnEnd = columnEnd;
            this.columnStart = columnStart;
            this.repair = repair;
            this.relatedInfo = relatedInfo;

            // The code below induces MagpieBridge dependency:
            // try {
            //     this.position = new IJPosition(lineStart, lineEnd, columnStart,
            //                                    columnEnd, sourceFilePath);
            //     this.code = SourceCodeReader.getLinesInString(position);
            // } catch (Exception e) {
            //     e.printStackTrace();
            // }
        }

        public int compareTo(Warning other) {
            if (lineStart.equals(other.lineStart)) {
                if (columnStart != null) {
                    if (columnStart.equals(other.columnStart))
                        return errMsg.compareTo(other.errMsg);
                    else {
                        if (columnStart != null && other.columnStart != null)
                            return Integer.compare(columnStart, other.columnStart);
                        else {
                            if (columnStart == null) {
                                return -1;
                            } else {
                                return 1;
                            }
                        }
                    }
                } else {
                    return Integer.compare(columnEnd, other.columnEnd);
                }
            } else {
                return Integer.compare(lineStart, other.lineStart);
            }
        }

        public Integer getLineStart() { return lineStart; }

        public Integer getColumnStart() { return columnStart; }

        public Integer getLineEnd() { return lineEnd; }

        public Integer getColumnEnd() { return columnEnd; }

        public String getErrMsg() { return errMsg; }

        public Pair<Position, String> getRepair() { return repair; }

        public java.util.List<Pair<Position, String>> getRelatedInfo() {
            return relatedInfo;
        }

        public IJPosition getPosition() { return position; }

        public String getCode() { return code; }

        public String getSourceFilePath() { return sourceFilePath; }

        public void print(PrintStream out) {
            print(out, false);
        }

        /**
         * Print this warning
         *
         * @param canonicalName Report the abstract analysis name (e.g., "DAA") insttead of
         *   the variant analysis implementation name (e.g. "PwDAA").
         */
        public void print(PrintStream out, boolean canonicalName) {
            final String reportedAnalysis = canonicalName ? analysis.canonicalName() : analysis.name();
            Utils.printWarning(out,
                               reportedAnalysis + " - " + sourceFilePath + ":" +
                               lineStart + "," + columnStart,
                               errMsg);
        }

        public String toString() {
            return analysis.name() + " - " + sourceFilePath + ":" + lineStart + "," +
                columnStart + " - " + errMsg;
        }

        public StaticAnalysis getAnalysisType() { return analysis; }

    }
}
