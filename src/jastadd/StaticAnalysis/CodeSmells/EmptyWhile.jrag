aspect EmptyWhile{
    // Add analysis to the StaticAnalysis registry:
    public static StaticAnalysis StaticAnalysis.EMPTYWHILE =
      new StaticAnalysis(StaticAnalysis.Kind.LOCAL_PATTERN,
                         "While statement with empty body") {
          @Override
          public Collection<? extends Warning> run(CompilationUnit cu) {
              return cu.EMPTYWHILE();
          }};

	WhileStmt contributes warning(
	  getCompilationUnit().pathName(),
	  "Empty 'while' statement may indicate unintended behavior." ,
	  StaticAnalysis.EMPTYWHILE, null, null) when
	  getStmt().getNumberStatements()==0 to CompilationUnit.EMPTYWHILE();

}
