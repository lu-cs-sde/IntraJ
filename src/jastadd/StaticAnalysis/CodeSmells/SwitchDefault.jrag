aspect SwitchDefault {
    // Add analysis to the StaticAnalysis registry:
    public static StaticAnalysis StaticAnalysis.SWITCHDEFAULT =
        new StaticAnalysis(StaticAnalysis.Kind.LOCAL_PATTERN,
                           "Switch statement without default") {
            @Override
            public Collection<? extends Warning> run(CompilationUnit cu) {
                return cu.SWITCHDEFAULT();
            }};

    SwitchStmt contributes warning(
        getCompilationUnit().pathName(),
        "Switch statement should have a default case." ,
        StaticAnalysis.SWITCHDEFAULT, null, null) when
        noDefaultLabel() to CompilationUnit.SWITCHDEFAULT();
}
